# ==============================================================================
# JanSetu AI - Root Environment Template
# NOTE: Copy this file to .env or use backend/.env and frontend/.env as needed.
# NEVER commit actual secrets or credentials to version control.
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansetu_ai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Security & Authentication
JWT_SECRET=your-secure-jwt-secret-key-placeholder-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini AI Configuration
GEMINI_API_KEY=your-google-gemini-api-key-placeholder
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
