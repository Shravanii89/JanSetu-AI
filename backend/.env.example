# ==============================================================================
# JanSetu AI - Backend Environment Template
# Path: backend/.env.example
# ==============================================================================

# Runtime Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansetu_ai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Authentication & JWT
JWT_SECRET=your-secure-jwt-secret-key-placeholder-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key-placeholder
GEMINI_MODEL=gemini-1.5-flash
